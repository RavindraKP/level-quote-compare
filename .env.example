# Copy to .env for local runs. In the cloud, set these in the host's environment settings.

# The app's own Claude key. Required for any model call; the app never uses ANTHROPIC_API_KEY.
LEVEL_ANTHROPIC_API_KEY=

# Models. Images may use a stronger model if the evals show it is needed.
LEVEL_MODEL=claude-haiku-5-5
LEVEL_VISION_MODEL=

# Passcode for the whole app. Leave empty to run without a gate (local only).
LEVEL_PASSCODE=

# Storage. On a host, point both at the persistent disk.
LEVEL_DB_PATH=data/level.db
LEVEL_UPLOAD_DIR=data/uploads
